<launch>
  <!-- No flight node is started here. Physical bridge starts by sending OFF. -->
  <arg name="enable_landing_illumination" default="false"/>
  <arg name="scope" default="single_hover_target"/>
  <arg name="enable_laser" default="false"/>
  <arg name="operator_pwm_verified" default="false"/>
  <arg name="start_camera" default="false"/>
  <arg name="video_device" default=""/>
  <arg name="offset_x_px" default="53.25"/>
  <arg name="offset_y_px" default="15.484375"/>
  <arg name="pwm_library" default="/home/abot/abot_ws/src/uav_mission/lib/liblib.so"/>
  <param name="/circle_pixel_preview/hover_servo" value="true" type="bool"/>
  <include file="$(find full_chain_vision_20261025_v6_1)/launch/air_hover_pixel_debug.launch">
    <arg name="preview_executable" value="circle_full_chain_servo_v6_1.py"/>
    <arg name="start_camera" value="$(arg start_camera)"/>
    <arg name="video_device" value="$(arg video_device)"/>
    <arg name="offset_x_px" value="$(arg offset_x_px)"/>
    <arg name="offset_y_px" value="$(arg offset_y_px)"/>
  </include>
  <node if="$(arg enable_laser)" pkg="full_chain_vision_20261025_v6_1" type="full_chain_target_laser_v6_1" name="hover_target_laser" output="screen" required="true">
    <param name="enable_laser" value="$(arg enable_laser)" type="bool"/>
    <param name="operator_pwm_verified" value="$(arg operator_pwm_verified)" type="bool"/>
    <param name="enable_landing_illumination" value="$(arg enable_landing_illumination)" type="bool"/>
    <param name="scope" value="$(arg scope)"/>
    <param name="pwm_library" value="$(arg pwm_library)"/>
  </node>
  <node pkg="full_chain_vision_20261025_v6_1" type="record_full_chain_v6_1.py" name="record_hover_vision" output="screen"/>
</launch>
