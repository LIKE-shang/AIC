<launch>
    <node pkg="full_chain_vision_20261025_v6_1" name="face_detector" type="face_detector.py" output="screen">
        <remap from="input_rgb_image" to="/camera/rgb/image_raw" />
        <rosparam>
            haar_scaleFactor: 1.2
            haar_minNeighbors: 2
            haar_minSize: 40
            haar_maxSize: 60
        </rosparam>
        <param name="cascade_1" value="$(find full_chain_vision_20261025_v6_1)/data/haar_detectors/haarcascade_frontalface_alt.xml" />
        <param name="cascade_2" value="$(find full_chain_vision_20261025_v6_1)/data/haar_detectors/haarcascade_profileface.xml" />
    </node>
</launch>
