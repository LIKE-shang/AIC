<launch>
  <!-- This device reported 640x400 depth support and produced real frames.
       RGB remains 640x480. Other devices must use their own supported modes.
       The guard auto-detects the real UVC PID; no hardcoded Pro model assumption. -->
  <arg name="camera_name" default="camera"/>
  <arg name="node_output" default="screen"/>
  <arg name="uvc_product_id" default="0"/>
  <arg name="depth_height" default="400"/>
  <group ns="$(arg camera_name)">
    <node pkg="astra_camera" type="astra_camera_node" name="camera" output="$(arg node_output)" required="true"
          launch-prefix="python3 $(find full_chain_rgbd_20261025_v6_1)/scripts/ground_camera_guard.py --camera-name $(arg camera_name) --uvc-product-id $(arg uvc_product_id)">
      <param name="camera_name" value="$(arg camera_name)"/>
      <param name="enable_color" value="true"/>
      <param name="use_uvc_camera" value="true"/>
      <param name="uvc_vendor_id" type="int" value="11205"/>
      <param name="uvc_product_id" type="int" value="0"/>
      <param name="uvc_camera_format" value="mjpeg"/>
      <param name="color_format" value="RGB"/>
      <param name="color_width" value="640"/>
      <param name="color_height" value="480"/>
      <param name="color_fps" value="30"/>
      <param name="enable_depth" value="true"/>
      <param name="depth_width" value="640"/>
      <param name="depth_height" value="$(arg depth_height)"/>
      <param name="depth_fps" value="30"/>
      <param name="depth_format" value="Y11"/>
      <param name="depth_align" value="false"/>
      <param name="depth_scale" type="int" value="1"/>
      <param name="color_depth_synchronization" value="false"/>
      <param name="enable_ir" value="false"/>
      <param name="enable_point_cloud" value="false"/>
      <param name="enable_point_cloud_xyzrgb" value="false"/>
      <param name="enable_d2c_viewer" value="false"/>
      <param name="publish_tf" value="true"/>
      <param name="tf_publish_rate" value="0.0"/>
      <param name="enable_publish_extrinsic" value="false"/>
      <param name="flip_color" value="false"/>
      <param name="flip_depth" value="false"/>
      <param name="uvc_flip" value="false"/>
    </node>
  </group>
</launch>